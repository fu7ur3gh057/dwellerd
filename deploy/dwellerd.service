[Unit]
Description=Dwellerd — host monitoring to Telegram
Documentation=https://github.com/fu7ur3gh057/dwellerd
After=network-online.target docker.service
Wants=network-online.target
# Five failed starts inside a minute means the config is broken, not that
# the network blipped — stop hammering and leave the unit failed.
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=__USER__
Group=__GROUP__
SupplementaryGroups=__SUPP_GROUPS__

WorkingDirectory=__INSTALL_DIR__
Environment=PYTHONUNBUFFERED=1
Environment=DWELLERD_CONFIG=/etc/dwellerd/config.yaml
ExecStart=__INSTALL_DIR__/.venv/bin/python -m dwellerd run

Restart=always
RestartSec=10

# The daemon reads the whole host on purpose (disks, journal, docker), so
# ProtectSystem / PrivateTmp are deliberately NOT set: they create a
# private mount namespace that hides the very bind-mounts we are asked to
# watch. Everything that can be locked down without blinding it, is.
NoNewPrivileges=yes
ReadWritePaths=/var/lib/dwellerd
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dwellerd

[Install]
WantedBy=multi-user.target
